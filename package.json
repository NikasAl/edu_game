{
  "name": "edu-game",
  "version": "0.1.0",
  "private": true,
  "description": "Учебник как игра: карта знаний, атомы идей, испытания Фейнмана, автопроверка. Локально-first PWA → Capacitor APK.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "gen:preinstall": "node tools/preinstall/gen-index.mjs",
    "build:android": "npm run build && npx cap sync android",
    "apk:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run build:android && cd android && ./gradlew assembleRelease",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@xyflow/react": "^12.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "djvujs-dist": "^0.5.4",
    "katex": "^0.18.9",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
